{
  "name": "@diggsweden/react-mla",
  "version": "1.2.2",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "glob": "^13.0.0",
    "i18next": "^26.5.7",
    "immer": "^11.0.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.5",
    "tailwindcss": "3.4.19",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "vis-util": "^6.0.2",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -p tsconfig.build.json && vite build && node ../../scripts/copy-meta.mjs packages/react-mla",
    "lint": "eslint ./src --max-warnings 0",
    "lint-fix": "eslint ./src --fix",
    "test": "vitest run --browser.headless --reporter=dot",
    "test:coverage": "vitest run --browser.headless --coverage",
    "test:install": "pnpm exec playwright install chromium",
    "test:browser": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.4",
    "@playwright/test": "1.64.1",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/offscreencanvas": "2019.7.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "sass-embedded": "1.106.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diggsweden/mla"
  }
}
